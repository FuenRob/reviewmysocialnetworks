# Configuración de ReviewMySocialNetworks
PORT=8080

# Credenciales de tu Aplicación de Meta / Instagram Graph API
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Alternativa para Docker/Kubernetes Secrets: INSTAGRAM_APP_SECRET_FILE=/run/secrets/instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:8080/api/instagram/auth/callback

# Credenciales de TikTok for Developers (Login Kit)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok exige una URI HTTPS absoluta y registrada, incluso para desarrollo.
TIKTOK_REDIRECT_URI=https://tu-dominio.example/api/tiktok/auth/callback

FRONTEND_URL=http://localhost:8080

# Actívalo solo si el backend no es accesible directamente y está detrás de un proxy de confianza.
TRUST_PROXY=false
