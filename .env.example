# Configuración de ReviewMySocialNetworks
PORT=8080

# Credenciales de tu Aplicación de Meta / Instagram Graph API
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8080/api/auth/callback
FRONTEND_URL=http://localhost:8080

# Actívalo solo si el backend no es accesible directamente y está detrás de un proxy de confianza.
TRUST_PROXY=false
